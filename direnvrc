# ~/.config/direnv/direnvrc - direnv + nix-direnv + mise integration
#
# In any project .envrc:
#   use flake          - for Nix flake-based dev shells
#   use mise           - for mise-managed runtimes (legacy/simple projects)
#   Both can be combined in the same .envrc

# nix-direnv: cached Nix dev shells (survives garbage collection)
if [[ -f "$HOME/.nix-profile/share/nix-direnv/direnvrc" ]]; then
  source "$HOME/.nix-profile/share/nix-direnv/direnvrc"
elif [[ -f "/nix/var/nix/profiles/default/share/nix-direnv/direnvrc" ]]; then
  source "/nix/var/nix/profiles/default/share/nix-direnv/direnvrc"
fi

# mise: runtime version manager
use_mise() {
  direnv_load mise direnv exec
}
