[Unit]
Description=tmux default session (detached)
Documentation=man:tmux(1)

[Service]
# oneshot+RemainAfterExit: forking hangs when a tmux server already exists
Type=oneshot
RemainAfterExit=yes
# apt/source tmux first, then brew, then mise (no-sudo servers)
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/linuxbrew/.linuxbrew/bin:%h/.local/share/mise/shims:%h/.local/bin
ExecStart=/usr/bin/env tmux new-session -A -d -s main
ExecStop=-%h/.tmux/plugins/tmux-resurrect/scripts/save.sh
ExecStop=/usr/bin/env tmux kill-server

[Install]
WantedBy=default.target
