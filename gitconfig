[user]
	email = royzah@gmail.com
	name = Royyan Zahir
	signingkey = ~/.ssh/id_ed25519.pub

[gpg]
	format = ssh

# Work repos: email and signing key from an untracked file (ignored when absent)
[includeIf "gitdir:~/Work/"]
	path = ~/.gitconfig.work

[commit]
	gpgsign = true

[init]
	defaultBranch = main

# --- Core behavior ---
[core]
	editor = nvim
	pager = delta
	autocrlf = input
	excludesfile = ~/.gitignore_global

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	default = current

[fetch]
	prune = true

[merge]
	conflictstyle = zdiff3

[rerere]
	enabled = true

[diff]
	algorithm = histogram
	colorMoved = default

[rebase]
	autoStash = true

# --- Delta (beautiful diffs) ---
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	hyperlinks = true
	syntax-theme = Catppuccin Mocha

[delta "decorations"]
	commit-decoration-style = blue ol
	commit-style = raw
	file-style = omit
	hunk-header-decoration-style = blue box
	hunk-header-file-style = red
	hunk-header-line-number-style = "#067a00"
	hunk-header-style = file line-number syntax

[interactive]
	diffFilter = delta --color-only

# --- Aliases ---
[alias]
	s = status -sb
	co = checkout
	cb = checkout -b
	cm = commit -m
	ca = commit --amend
	p = push
	pf = push --force-with-lease
	pl = pull
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	last = log -1 HEAD --stat
	unstage = reset HEAD --
	undo = reset --soft HEAD~1
	stash-all = stash save --include-untracked
	branches = branch -a --sort=-committerdate
	tags = tag -l
	remotes = remote -v
	cleanup = !git branch --merged | grep -v '\\*\\|main\\|master\\|develop' | xargs -n 1 git branch -d
	wip = !git add -A && git commit -m 'wip [skip ci]'
[credential "https://github.com"]
	helper = 
	helper = !/home/linuxbrew/.linuxbrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/home/linuxbrew/.linuxbrew/bin/gh auth git-credential
[sendemail]
	smtpEncryption = tls
	smtpServer = smtp.gmail.com
	smtpServerPort = 587
	smtpUser = royzah@gmail.com
	from = Royyan Zahir <royzah@gmail.com>
[branch]
	autoSetupMerge = false

# Machine-local overrides, last so they win (a work machine sets its identity here)
[include]
	path = ~/.gitconfig.local
