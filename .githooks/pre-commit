#!/usr/bin/env bash
# Block commits that leak secrets or private names into this public repo.
# Private patterns live untracked in ~/.config/dotfiles/denylist (one ERE per
# line, # for comments) so the patterns themselves are never published.
set -euo pipefail

denylist="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/denylist"
added=$(git diff --cached -U0 --no-color --diff-filter=ACMR | awk '/^\+\+\+ /{next} /^\+/{print}')
fail=0

if [[ -f $denylist ]]; then
  patterns=$(grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$denylist" || true)
  if [[ -n $patterns && -n $added ]]; then
    hits=$(grep -iE -f <(printf '%s\n' "$patterns") <<< "$added" || true)
    if [[ -n $hits ]]; then
      echo "pre-commit: staged lines match $denylist:" >&2
      printf '%s\n' "$hits" >&2
      fail=1
    fi
  fi
else
  echo "pre-commit: no $denylist; private-name check skipped" >&2
fi

if command -v gitleaks > /dev/null; then
  gitleaks git --pre-commit --staged --no-banner --log-level warn -v --redact=50 . >&2 || fail=1
else
  echo "pre-commit: gitleaks not installed (mise install); secret scan skipped" >&2
fi

if ((fail)); then
  echo "pre-commit: commit blocked. Move the value to an untracked local file." >&2
  exit 1
fi
